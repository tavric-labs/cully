{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal codex-signal; fi",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal guard codex; fi",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal continuity codex start; fi",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal continuity codex turn; fi",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal continuity codex prompt; fi",
            "type": "command"
          }
        ]
      }
    ]
  }
}
