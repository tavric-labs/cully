{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "cully _internal codex-signal",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cully _internal continuity codex start",
            "type": "command"
          }
        ]
      }
    ]
  }
}
