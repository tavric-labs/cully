{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal pane-signal claude; fi",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal guard claude; fi",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Read|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal cleanup; fi",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal continuity claude start; fi",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal analyze; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal continuity claude stop; fi",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "if [ \"${CULLY_RUN_ACTIVE:-}\" = \"1\" ]; then cully _internal continuity claude prompt; fi",
            "type": "command"
          }
        ]
      }
    ]
  }
}
