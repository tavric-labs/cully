{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "cully _internal pane-signal claude",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "cully _internal guard claude",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Read|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "cully _internal cleanup",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cully _internal continuity claude start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "cully _internal analyze",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "cully _internal continuity claude stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
