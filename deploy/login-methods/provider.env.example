# Passed only to mcp-auth. Match the *_env names in your provider JSON.
# LDAP search service account password, NOT an end user's password.
MCP_AUTH_LDAP_BIND_PASSWORD=replace-with-directory-read-account-password
# For Google/GitHub, add their client ID and secret variables here instead.
# MCP_AUTH_GOOGLE_CLIENT_ID=
# MCP_AUTH_GOOGLE_CLIENT_SECRET=
# MCP_AUTH_GITHUB_CLIENT_ID=
# MCP_AUTH_GITHUB_CLIENT_SECRET=
