# Separate deployment: never reuse an existing Keycloak deployment's data or secrets.
# Required after mcp-auth PR #32 is merged AND its image is published. No default.
MCP_AUTH_IMAGE=
# Select the matching published Cully MCP, data and Mem0 release tag.
CULLY_IMAGE_TAG=
# HTTPS origins served by your existing reverse proxy. No trailing slash on issuer.
CULLY_AUTH_ISSUER=https://cully-auth.example.com
CULLY_AUTH_RESOURCE=https://cully.example.com/mcp
CULLY_MCP_PORT=3393
CULLY_AUTH_PORT=8081
# Generate independent secrets. URL-encode the database password in the URL.
CULLY_DB_PASSWORD=replace-with-database-password
CULLY_DATABASE_URL=postgres://cully:replace-with-url-encoded-database-password@db:5432/cully
CULLY_DATA_API_TOKEN=replace-with-private-data-api-token
CULLY_MEM0_DB_PASSWORD=replace-with-separate-mem0-database-password
CULLY_MEM0_API_KEY=replace-with-mem0-api-key
CULLY_MEM0_JWT_SECRET=replace-with-mem0-jwt-secret
