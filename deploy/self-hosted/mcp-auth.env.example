# Copy to a private file and pass it with cully setup --mcp-auth-env.
# Config paths refer to files inside the --mcp-auth-config-dir mount.
MCP_AUTH_LOGIN_METHODS_FILE=/etc/mcp-auth/login-methods.json
# Only for methods using named OIDC/OAuth connectors:
# MCP_AUTH_CONNECTORS_FILE=/etc/mcp-auth/connectors.json
# Set only the provider variables referenced by your chosen mcp-auth config.
# MCP_AUTH_GOOGLE_CLIENT_ID=
# MCP_AUTH_GOOGLE_CLIENT_SECRET=
# MCP_AUTH_LDAP_BIND_PASSWORD=
